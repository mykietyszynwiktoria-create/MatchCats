# Local development only. Copy to .env and replace this example password.
DB_PASSWORD=change-this-local-demo-password

# Set true only when the app is served through HTTPS in production.
COOKIE_SECURE=false

# Replace with the exact HTTPS frontend origin(s) in production, comma-separated.
APP_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Keep framework when deploying behind an HTTPS reverse proxy.
FORWARD_HEADERS_STRATEGY=framework

# Optional email delivery. Keep disabled until a real provider is configured.
MAIL_ENABLED=false
MAIL_FROM=
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MODERATOR_ACCOUNT_IDS=

